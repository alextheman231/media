{
  "name": "media",
  "version": "1.0.0",
  "description": "Media used in my projects, often created with Manim.",
  "author": "alextheman",
  "license": "ISC",
  "main": "index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/media.git"
  },
  "sideEffects": false,
  "scripts": {
    "format-package-json": "eslint --fix --suppress-all package.json && rm -f eslint-suppressions.json",
    "format-yml": "oxfmt \"**/*.{yml,yaml}\"",
    "generate": "bash -c 'alex-c-line internal media generate $@' --",
    "lint-exact-versions": "alex-c-line pyproject check --rules prefer-exact-dependency-versions",
    "lint-package-json": "eslint package.json",
    "lint-yml": "oxfmt --check \"**/*.{yml,yaml}\"",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devDependencies": {
    "@alextheman/eslint-plugin": "5.18.9",
    "alex-c-line": "2.18.3",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "oxfmt": "0.79.0"
  }
}
